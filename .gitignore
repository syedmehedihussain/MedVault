# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# puku local tool state. Its embedding DB stores raw chunks of every file it
# indexes, including gitignored ones like .env.local, so this directory must
# never be committed — a tracked index is what leaked real keys to the public
# remote on 2026-07-26.
.puku/

# typescript
*.tsbuildinfo
next-env.d.ts
